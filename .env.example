# Update with your on-prem PostgreSQL connection string
DATABASE_URL="postgresql://hams_user:hams_password@localhost:5432/hams_db?schema=public"
AUTH_SECRET="replace-with-a-long-random-string"
# For a facility deployment, set this to how staff actually reach the
# server — e.g. "http://192.168.1.50:3000" — not localhost.
AUTH_URL="http://localhost:3000"

# Optional — override the credentials docker-compose.yml creates the
# Postgres container with (must then match DATABASE_URL above). Left
# unset, docker-compose.yml falls back to hams_user/hams_password/hams_db.
# deploy/install.sh generates a random POSTGRES_PASSWORD for you.
# POSTGRES_USER="hams_user"
# POSTGRES_PASSWORD="hams_password"
# POSTGRES_DB="hams_db"

# --- Backups (see README.md > Backups) ---
# Requires the PostgreSQL client tools (pg_dump) installed on this server.
# Where backup files are written. Defaults to ./backups if unset.
# BACKUP_DIR="./backups"
# Full path to pg_dump, if it isn't on PATH.
# PG_DUMP_PATH="pg_dump"
# Set to "false" to turn off the automatic schedule (manual backups from
# Dashboard > Data Backup still work either way).
# BACKUP_AUTO_ENABLED="true"
# How often automatic backups run, in hours. Defaults to 24.
# BACKUP_INTERVAL_HOURS="24"
# How many backups (manual + automatic combined) to keep before deleting
# the oldest. Defaults to 14.
# BACKUP_RETENTION_COUNT="14"

# --- DHIS2 integration (Reports > "Push to DHIS2") ---
# Sends a report's monthly figures to a DHIS2 server's /api/dataValueSets.
# The button only appears (for ADMIN users) when DHIS2_URL, an auth method
# and DHIS2_ORG_UNIT are all set; leave DHIS2_URL blank to disable it.
# See README.md > DHIS2 integration.
# Base URL of the DHIS2 server, no trailing slash and no /api.
# DHIS2_URL="https://dhis2.example.org"
# Personal access token (DHIS2 > Apps & tokens) — preferred.
# DHIS2_TOKEN=""
# Username/password fallback, used only when DHIS2_TOKEN is unset.
# DHIS2_USERNAME=""
# DHIS2_PASSWORD=""
# UID of the org unit this facility reports as.
# DHIS2_ORG_UNIT=""
# Path to the report-cell -> DHIS2 UID map. Defaults to
# ./config/dhis2-mapping.json (copy config/dhis2-mapping.example.json).
# DHIS2_MAPPING_PATH="./config/dhis2-mapping.json"
# Optional dataSet UID; when set, the push marks it complete for the period.
# DHIS2_DATASET=""
# Optional categoryOptionCombo UID used when a mapping entry omits one.
# DHIS2_DEFAULT_COC=""
# Set "true" to validate against DHIS2 without saving (dryRun).
# DHIS2_DRY_RUN="false"
# Set "true" to also send cells whose value is 0.
# DHIS2_INCLUDE_ZEROS="false"
# Set "true" to trust this DHIS2 server's TLS certificate even if it's
# self-signed / unverifiable (common for an on-prem instance with no
# CA-signed cert). Scoped to just this connection, not the whole app.
# DHIS2_ALLOW_SELF_SIGNED_CERT="false"
