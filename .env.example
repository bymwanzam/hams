# Update with your on-prem PostgreSQL connection string
DATABASE_URL="postgresql://hams_user:hams_password@localhost:5432/hams_db?schema=public"
AUTH_SECRET="replace-with-a-long-random-string"
# For a facility deployment, set this to how staff actually reach the
# server — e.g. "http://192.168.1.50:3000" — not localhost.
AUTH_URL="http://localhost:3000"

# Optional — override the credentials docker-compose.yml creates the
# Postgres container with (must then match DATABASE_URL above). Left
# unset, docker-compose.yml falls back to hams_user/hams_password/hams_db.
# deploy/install.sh generates a random POSTGRES_PASSWORD for you.
# POSTGRES_USER="hams_user"
# POSTGRES_PASSWORD="hams_password"
# POSTGRES_DB="hams_db"

# --- Backups (see README.md > Backups) ---
# Requires the PostgreSQL client tools (pg_dump) installed on this server.
# Where backup files are written. Defaults to ./backups if unset.
# BACKUP_DIR="./backups"
# Full path to pg_dump, if it isn't on PATH.
# PG_DUMP_PATH="pg_dump"
# Set to "false" to turn off the automatic schedule (manual backups from
# Dashboard > Data Backup still work either way).
# BACKUP_AUTO_ENABLED="true"
# How often automatic backups run, in hours. Defaults to 24.
# BACKUP_INTERVAL_HOURS="24"
# How many backups (manual + automatic combined) to keep before deleting
# the oldest. Defaults to 14.
# BACKUP_RETENTION_COUNT="14"
