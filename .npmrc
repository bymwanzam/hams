# Facility servers often sit on thin or flaky links (see deploy/). npm's
# defaults (15 parallel sockets, 5-minute request timeout, 2 retries) make
# `npm ci` fail there with EIDLETIMEOUT: too many downloads share too little
# bandwidth and individual sockets go idle past the timeout.
#
# Fewer parallel sockets => each download gets real bandwidth and finishes;
# longer timeouts and more retries ride out transient stalls.
maxsockets=3
fetch-timeout=600000
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
